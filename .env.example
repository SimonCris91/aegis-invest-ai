# Safe, non-secret Aegis Invest AI defaults.
AEGIS_DOTENV_ENABLED=true
AEGIS_ENVIRONMENT=DEMO
AEGIS_KILL_SWITCH=true
AEGIS_SECONDARY_NEWS_RELAY_KEY=
AEGIS_SECONDARY_NEWS_RELAY_URL=https://relay.aquariusageai.com/api/secondary/news
AEGIS_SECONDARY_NEWS_SOURCE_ID=secondary-pc
AEGIS_LOG_LEVEL=INFO
AEGIS_PAPER_TRADING_ENABLED=true

# Offline providers are selected by default.
AEGIS_MARKET_DATA_PROVIDER=fixture
AEGIS_NEWS_PROVIDER=fixture
AEGIS_AI_PROVIDER=deterministic
AEGIS_BROKER_PROVIDER=none
AEGIS_ETORO_READ_ENABLED=false
AEGIS_OPERATING_MODE=OFFLINE_PAPER
ETORO_API_ENABLED=false
ETORO_DEMO_EXECUTION_ENABLED=false
ETORO_DEMO_SMOKE_TEST_OPT_IN=false
AEGIS_ETORO_TRANSPORT_MODE=SYSTEM_PROXY
AEGIS_EXECUTION_POLICY=ADVISORY
AEGIS_AUTHORIZED_CAPITAL=200
AEGIS_AUTHORIZED_CAPITAL_CURRENCY=EUR
AEGIS_ETORO_DEMO_PILOT_NOTIONAL=200

# Confidence profile activation is explicit and reversible.
# Empty/unset behaves as V1_LEGACY, the conservative default.
# Use V2_B_GUARDED only after reviewing Step 8.0A evidence.
# Roll back by setting AEGIS_CONFIDENCE_PROFILE=V1_LEGACY.
# V2_B keeps threshold 0.5475 guarded; EQUITY OOS evidence is weaker than ETF/CRYPTO.
AEGIS_CONFIDENCE_PROFILE=V1_LEGACY

# Runtime-only placeholders. Never commit populated values or persist them.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_EXPECTED_USERNAME=
ETORO_EXPECTED_GCID=

# Read-only eToro readiness probes. Keep empty until credentials and identity checks are ready.
AEGIS_ETORO_READINESS_SYMBOL=
AEGIS_ETORO_READINESS_INSTRUMENT_ID=
AEGIS_ETORO_READINESS_MAX_QUOTE_AGE_SECONDS=300

# Read-only market scanner. Empty search text lets the broker search endpoint decide the page.
AEGIS_SCANNER_DISCOVERY_LIMIT=50
AEGIS_SCANNER_RANKED_SHORTLIST_LIMIT=20
AEGIS_SCANNER_DEEP_ANALYSIS_LIMIT=5
AEGIS_ETORO_SCAN_SEARCH_TEXT=
AEGIS_ETORO_SCAN_MAX_PAGES=1

# Continuous read-only universe maintenance. The Demo runner advances this
# bounded bootstrap cursor automatically; provider 429 cooldown is respected.
AEGIS_UNIVERSE_MAINTENANCE_ENABLED=true
AEGIS_UNIVERSE_MAINTENANCE_BATCH_SIZE=16
AEGIS_UNIVERSE_MAINTENANCE_EVERY_POLLS=1
AEGIS_ETORO_CATALOG_REFRESH_INTERVAL_SECONDS=21600

# Empty placeholders only. This build never reads or logs provider secrets.
AEGIS_MARKET_DATA_API_KEY=
AEGIS_NEWS_API_KEY=
AEGIS_AI_API_KEY=

# Optional secondary read-only news corroboration. Keep primary Alpha Vantage
# active and set this to alpaca only after adding both Alpaca key variables.
AEGIS_NEWS_SECONDARY_PROVIDER=none

# Optional public GDELT global-news discovery feed. The adapter limits requests
# to one per five seconds and caches results for ten minutes.
AEGIS_NEWS_GDELT_ENABLED=false

# Optional read-only historical research provider for Step 8.0J+.
# Runtime only; never log, print, persist, or commit populated values.
AEGIS_POLYGON_API_KEY=
MASSIVE_API_KEY=

# Optional read-only Alpaca historical research provider for Step 8.0K+.
# Runtime only; never log, print, persist, or commit populated values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
